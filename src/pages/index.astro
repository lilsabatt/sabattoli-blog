---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="inicio">
				<div class="dolar-widget">
	<div class="dolar-titulo">💵 dólar blue</div>
	<div id="dolar-compra"></div>
	<div id="dolar-venta"></div>
	<div id="dolar-fecha"></div>
</div>
				<div class="texto">
					<h1>bienvenido.</h1>
					<p>
						Espero te sientas a gusto en mi blog. Aca voy a publicar articulos de opinion, reseñas, recetas, etc etc etc.
					</p>
					<p><a href="/blog">ver publicaciones sesudas→</a></p>
					<p><a href="/pics">ver dibujos→</a></p>
					<iframe src="https://open.spotify.com/embed/track/3FtYbEfBqAlGO46NUDQSAt?utm_source=generator" width="100%" height="80" frameborder="0" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
					<img src="/GIFS/GIFGATO.gif" alt="TOGA">
				</div>
				<div class="luna-widget">
					<div id="luna-emoji"></div>
					<div id="luna-nombre"></div>
				</div>
			</div>
			<div class="newsletter">
				<h3>suscribite al newsletter!</h3>
				<iframe src="https://gsabatt.substack.com/embed" width="100%" height="200" style="border: 1px solid #ccc; background: #eee8d8;" frameborder="0" scrolling="no"></iframe>
			</div>
		</main>
		<script>
			function getMoonPhase() {
				const now = new Date();
				const year = now.getFullYear();
				const month = now.getMonth() + 1;
				const day = now.getDate();

				let y = year, m = month;
				if (m < 3) { y--; m += 12; }
				const a = Math.floor(y / 100);
				const b = 2 - a + Math.floor(a / 4);
				const jd = Math.floor(365.25 * (y + 4716)) + Math.floor(30.6001 * (m + 1)) + day + b - 1524.5;
				const daysSinceNew = (jd - 2451549.5) % 29.53058867;
				const phase = ((daysSinceNew % 29.53058867) + 29.53058867) % 29.53058867;

				if (phase < 1.85) return { emoji: '🌑', nombre: 'luna nueva' };
				if (phase < 7.38) return { emoji: '🌒', nombre: 'cuarto creciente' };
				if (phase < 9.22) return { emoji: '🌓', nombre: 'media luna creciente' };
				if (phase < 14.77) return { emoji: '🌔', nombre: 'luna gibosa creciente' };
				if (phase < 16.61) return { emoji: '🌕', nombre: 'luna llena' };
				if (phase < 22.15) return { emoji: '🌖', nombre: 'luna gibosa menguante' };
				if (phase < 23.99) return { emoji: '🌗', nombre: 'media luna menguante' };
				if (phase < 29.53) return { emoji: '🌘', nombre: 'cuarto menguante' };
				return { emoji: '🌑', nombre: 'luna nueva' };
			}

			const { emoji, nombre } = getMoonPhase();
			document.getElementById('luna-emoji')!.textContent = emoji;
			document.getElementById('luna-nombre')!.textContent = nombre;
			fetch('https://dolarapi.com/v1/dolares/blue')
	.then(r => r.json())
	.then(d => {
		document.getElementById('dolar-compra')!.textContent = `compra: $${d.compra}`;
		document.getElementById('dolar-venta')!.textContent = `venta: $${d.venta}`;
		document.getElementById('dolar-fecha')!.textContent = d.fechaActualizacion?.slice(0,10) ?? '';
	});
	setTimeout(() => {
	const popup = document.createElement('div');
	popup.innerHTML = `
		<div id="virus-popup" style="
			position: fixed;
			top: 50%;
			left: 50%;
			transform: translate(-50%, -50%);
			background: #c0c0c0;
			border: 3px solid #000;
			box-shadow: 4px 4px 0 #000;
			width: 320px;
			font-family: 'Arial', sans-serif;
			font-size: 13px;
			z-index: 9999;
		">
			<div style="background: #000080; color: white; padding: 4px 8px; display: flex; justify-content: space-between; align-items: center;">
				<span>⚠️ Advertencia del Sistema</span>
				<span id="cerrar-popup" style="cursor: pointer; font-weight: bold; padding: 0 6px;">✕</span>
			</div>
			<div style="padding: 16px; text-align: center;">
				<div style="font-size: 2em; margin-bottom: 8px;">🦠</div>
				<p style="margin: 0 0 12px 0;"><strong>¡ADVERTENCIA!</strong><br>Se detectaron 3 virus en tu computadora.</p>
				<p style="margin: 0 0 16px 0; color: red; font-weight: bold;">Tu PC está en peligro.</p>
				<button onclick="document.getElementById('virus-popup').remove()" style="
					background: #c0c0c0;
					border: 2px solid;
					border-color: #fff #000 #000 #fff;
					padding: 4px 16px;
					cursor: pointer;
					font-size: 13px;
					margin-right: 8px;
				">Aceptar</button>
				<button onclick="document.getElementById('virus-popup').remove()" style="
					background: #c0c0c0;
					border: 2px solid;
					border-color: #fff #000 #000 #fff;
					padding: 4px 16px;
					cursor: pointer;
					font-size: 13px;
				">Cancelar</button>
			</div>
		</div>
	`;
	document.body.appendChild(popup);
	document.getElementById('cerrar-popup')!.onclick = () => popup.remove();
}, 2000);
		</script>
		<Footer />
	</body>
</html>

<style>
	.inicio {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 2em;
	}
	.dolar-widget {
	position: fixed;
	left: 2em;
	top: 50%;
	transform: translateY(-50%);
	text-align: center;
	border: 1px solid #ccc;
	padding: 1.5em;
	background: #eee8d8;
	min-width: 140px;
	font-family: Verdana, sans-serif;
	font-size: 0.85em;
	color: #333;
}
.dolar-titulo {
	font-weight: bold;
	margin-bottom: 0.5em;
	font-size: 1em;
}
	.texto {
		flex: 1;
	}
	.luna-widget {
		position: fixed;
		right: 2em;
		top: 50%;
		transform: translateY(-50%);
		text-align: center;
		border: 1px solid #ccc;
		padding: 1.5em;
		background: #eee8d8;
		min-width: 140px;
	}
	#luna-emoji {
		font-size: 5em;
		line-height: 1;
		display: block;
	}
	#luna-nombre {
		font-family: Verdana, sans-serif;
		font-size: 0.8em;
		color: #555;
		margin-top: 0.5em;
	}
	.newsletter {
		margin-top: 2em;
		border-top: 1px solid #ccc;
		padding-top: 1em;
	}
</style>